########################################
# rv32i_chip.mmmc.view - RV32I MCU chip with the UART IP, lab style (same as the lab mmmc view
# cmsdk_mcu.mmmc.view, only paths and names changed)
#  $GPDK045 is set in all.tcl before init_design (GPDK045 folder at / on the school server)
#  Pad libraries added to the library sets (pads_FF_s1vg / pads_SS_s1vg).
#  RC corners without the lab -cap_table: that table (cln28hpl_...capTbl) is for a 28 nm process and
#  gave the ~0.9 mm pad-to-core nets max_tran up to 1.154 ns (limit 0.28, 97 nets) and IO setup
#  -0.818 ns after CTS (2026-11-26). Only the gpdk045 QRC tech file is used, as in pnr/ch06_chip.
#  Constraints: ./rv32i_chip_func.sdc (13 ns target). Two constraint modes with the same SDC
#  (FUNC_S for the slow view, FUNC_F for the fast view) instead of the lab's one FUNC mode: after CTS
#  the virtual clock vclk gets the clock insertion delay measured in each view (slow and fast differ).
########################################

########################################
########## Create RC_ Corner ###########
########################################

create_rc_corner -name BEST \
   -preRoute_res {1.0} \
   -preRoute_cap {1.0} \
   -preRoute_clkres {0.0} \
   -preRoute_clkcap {0.0} \
   -postRoute_res {1.0} \
   -postRoute_cap {1.0} \
   -postRoute_xcap {1.0} \
   -postRoute_clkres {0.0} \
   -postRoute_clkcap {0.0} \
   -T 0 \
   -qx_tech_file $GPDK045/digital/gsclib045_all_v4.4/gsclib045/qrc/qx/gpdk045.tch

create_rc_corner -name WORST \
   -preRoute_res {1.0} \
   -preRoute_cap {1.0} \
   -preRoute_clkres {0.0} \
   -preRoute_clkcap {0.0} \
   -postRoute_res {1.0} \
   -postRoute_cap {1.0} \
   -postRoute_xcap {1.0} \
   -postRoute_clkres {0.0} \
   -postRoute_clkcap {0.0} \
   -T 125 \
   -qx_tech_file $GPDK045/digital/gsclib045_all_v4.4/gsclib045/qrc/qx/gpdk045.tch

########################################
########## Create Library_Set ##########
########################################

create_library_set -name FF_Min_1p10v_0c \
   -timing \
    [list \
	$GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v0_basicCells.lib \
	$GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v0_multibitsDFF.lib \
	$GPDK045/digital/giolib045_v3.5/timing/pads_FF_s1vg.lib \
    ]

create_library_set -name SS_Max_0p90v_125c \
   -timing \
    [list \
	$GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/slow_vdd1v0_basicCells.lib \
	$GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/slow_vdd1v0_multibitsDFF.lib \
	$GPDK045/digital/giolib045_v3.5/timing/pads_SS_s1vg.lib \
    ]


########################################
########## Create Delay_Corner #########
########################################

create_delay_corner -name FF_BEST \
   -library_set FF_Min_1p10v_0c \
   -rc_corner BEST

create_delay_corner -name SS_WORST \
   -library_set SS_Max_0p90v_125c \
   -rc_corner WORST


############################################
########## Create Constraint_Mode ##########
############################################

create_constraint_mode -name FUNC_S \
   -sdc_files [list ./rv32i_chip_func.sdc]
create_constraint_mode -name FUNC_F \
   -sdc_files [list ./rv32i_chip_func.sdc]


############################################
########### Create Analysis_view ###########
############################################

create_analysis_view -name FUNC_FF_BEST \
   -constraint_mode FUNC_F \
   -delay_corner FF_BEST

create_analysis_view -name FUNC_SS_WORST \
   -constraint_mode FUNC_S \
   -delay_corner SS_WORST

############################################
############ Set Analysis_view #############
############################################

set_analysis_view -setup [list FUNC_SS_WORST] \
   -hold [list FUNC_FF_BEST]
